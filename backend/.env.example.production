# RAYS Backend - Production Environment Configuration
# Copy this file to .env and update with actual values

# ─── Application Configuration ───────────────────────────
FLASK_ENV=production
SECRET_KEY=your-production-secret-key-here-min-32-chars
DEBUG=False

# ─── API Configuration ──────────────────────────────────
VALID_API_KEYS=your-api-key-1,your-api-key-2,your-api-key-3
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
API_KEY_HEADER=X-API-Key

# ─── Database Configuration ─────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/rays_db
# For SQLite (development only): DATABASE_URL=sqlite:///rays.db
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_MAX_OVERFLOW=20

# ─── Redis Configuration ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_PREDICT=30 per minute

# ─── ML Model Configuration ─────────────────────────────
MODEL_PATH=app/models/stress_predictor.pkl
MODEL_VERSION=3.0.0

# ─── Logging Configuration ──────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Security Configuration ─────────────────────────────
ENABLE_HTTPS=True
REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=1048576

# ─── Monitoring Configuration ───────────────────────────
ENABLE_PROMETHEUS=True
ENABLE_ERROR_TRACKING=True
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Email Configuration (optional) ──────────────────────
MAIL_SERVER=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=your-email-password
MAIL_USE_TLS=True

# ─── Gunicorn Configuration ─────────────────────────────
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=1000
TIMEOUT=30
KEEPALIVE=2
